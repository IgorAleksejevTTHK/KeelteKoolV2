@model KeelteKoolV2.Models.Lecturers.LecturerViewModel

@if (ViewBag.ViewType == "details")
{
    <h1>Õpetaja andmed</h1>
}
else
{
    <h1>Kustuta õpetaja</h1>
}

<div>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label class="col-sm-2 col-form-label">Id</label>
            <span id="DD_LecturerGuid">@Model.Id</span>
        </div>
    </dl>
    <dl class="row">
        <div class="form-group row">
            <label class="col-sm-2 col-form-label">Eesnimi</label>
            <span id="DD_LecturerFirstName">@Model.FirstName</span>
        </div>
    </dl>
    <dl class="row">
        <div class="form-group row">
            <label class="col-sm-2 col-form-label">Perenimi</label>
            <span id="DD_LecturerLastName">@Model.LastName</span>
        </div>
    </dl>
    <dl class="row">
        <div class="form-group row">
            <label class="col-sm-2 col-form-label">Kvalifikatsioon</label>
            <span id="DD_LecturerQualifications">@Model.Qualifications</span>
        </div>
    </dl>
    @if (ViewBag.ViewType == "delete")
    {
        <form asp-action="DeleteConfirmed" asp-controller="Lecturers">
            <input type="hidden" asp-for="Id" />
            <input id="DeleteDelete_BTN" type="submit" value="Kustuta" class="btn btn-danger" />
            <a id="DeleteCancel_BTN" asp-action="Index" asp-controller="Lecturers" class="btn btn-primary">Tühista</a>
        </form>
    }
    else
    {
        <a id="DetailsUpdate_BTN" asp-action="Update" asp-controller="Lecturers" asp-route-id="@Model.Id" class="btn btn-warning">Muuda</a>
        <a id="DetailsBack_BTN" asp-action="Index" asp-controller="Lecturers" class="btn btn-primary">Tagasi</a>
    }
</div>
